PORT=3020
DATABASE_HOST=localhost
DATABASE_PORT=5462
DATABASE_NAME=gym
DATABASE_USER=gym
DATABASE_PASSWORD=gym
# Авторизация. В проде — длинные случайные значения (openssl rand -hex 32).
JWT_SECRET=dev-jwt-secret-change-me
CODE_PEPPER=dev-code-pepper-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90
AUTH_RATE_LIMIT_PER_MINUTE=10
# Первый админ (apps/admin): создаётся при старте, если админов ещё нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=dev-admin-password
# ИИ-агент на платформе ultra-ai: POST <url>, x-api-key. См. docs/ai-agent-contract.md.
AI_AGENT_INVOKE_URL=
AI_AGENT_API_KEY=
# Необязательно: свой агент на шаг анализа.
# AI_AGENT_INVOKE_JOURNAL_URL=
# AI_AGENT_INVOKE_PROGRAM_URL=
# Анализов ИИ в сутки на тренера (админ может задать своё).
AI_DAILY_LIMIT=20
